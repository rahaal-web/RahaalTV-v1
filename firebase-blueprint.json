{
  "entities": {
    "Media": {
      "title": "Media",
      "description": "Movie, series, TV show, or wrestling catalog document stored in RahaL TV.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "englishTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "type": "string", "enum": ["movie", "series", "tv", "wrestling"] },
        "categories": { "type": "array", "description": "Taxonomy categories (1 to 10 items)" },
        "genres": { "type": "array", "description": "Media genres (1 to 10 items)" },
        "year": { "type": "string", "minLength": 4, "maxLength": 10 },
        "country": { "type": "string", "minLength": 1, "maxLength": 80 },
        "language": { "type": "string", "minLength": 1, "maxLength": 80 },
        "quality": { "type": "string", "minLength": 1, "maxLength": 40 },
        "duration": { "type": "string", "minLength": 1, "maxLength": 40 },
        "imdb": { "type": "number" },
        "votes": { "type": "string", "minLength": 1, "maxLength": 40 },
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "pinned": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "comingSoon": { "type": "boolean" },
        "poster": { "type": "string", "minLength": 1, "maxLength": 500 },
        "backdrop": { "type": "string", "minLength": 1, "maxLength": 500 },
        "poster_url": { "type": "string", "maxLength": 500 },
        "backdrop_url": { "type": "string", "maxLength": 500 },
        "poster_width": { "type": "number" },
        "poster_height": { "type": "number" },
        "backdrop_width": { "type": "number" },
        "backdrop_height": { "type": "number" },
        "image_source": { "type": "string", "maxLength": 60 },
        "image_quality_status": {
          "type": "string",
          "enum": ["high", "medium", "low", "missing_backdrop", "unknown"]
        },
        "tagline": { "type": "string", "maxLength": 400 },
        "story": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "shortUrl": { "type": "string", "maxLength": 300 },
        "trailerUrl": { "type": "string", "maxLength": 500 },
        "trailerLabel": { "type": "string", "maxLength": 200 },
        "trailerDuration": { "type": "string", "maxLength": 30 },
        "cast": { "type": "array" },
        "seasons": { "type": "array" },
        "franchiseIds": { "type": "array" },
        "servers": { "type": "array" },
        "downloads": { "type": "array" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "slug",
        "title",
        "englishTitle",
        "kind",
        "categories",
        "genres",
        "year",
        "country",
        "language",
        "quality",
        "duration",
        "imdb",
        "votes",
        "views",
        "likes",
        "pinned",
        "isNew",
        "comingSoon",
        "poster",
        "backdrop",
        "tagline",
        "story",
        "shortUrl",
        "trailerUrl",
        "trailerLabel",
        "trailerDuration",
        "cast",
        "seasons",
        "franchiseIds",
        "servers",
        "downloads",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "VisitorRequest": {
      "title": "VisitorRequest",
      "description": "User-submitted media request reviewed and fulfilled by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requesterName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "type": "string", "enum": ["فيلم", "مسلسل", "عرض مصارعة", "مسرحية"] },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "completed", "rejected"] },
        "adminNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "requesterName",
        "title",
        "type",
        "notes",
        "status",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Publicly non-PII user profile storing display name and personal watchlist IDs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "watchlistIds": { "type": "array" },
        "role": { "type": "string", "enum": ["member", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoURL", "watchlistIds", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII storage for authenticated user email.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator and moderator RBAC registry document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "addedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "enum": ["owner", "moderator"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "addedBy", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global RahaL TV configuration managed by administrators.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 300 },
        "announcementText": { "type": "string", "maxLength": 300 },
        "tickerEnabled": { "type": "boolean" },
        "featuredLimit": { "type": "number" },
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string", "maxLength": 500 },
        "playerTheme": { "type": "object", "description": "Customizable internal video player theme configuration" },
        "homeConfig": { "type": "object", "description": "Customizable homepage layout, hero slider controls, and ordered sections configuration" },
        "typography": { "type": "object", "description": "Customizable global font families and font sizes configuration" },
        "popupShield": { "type": "object", "description": "Smart Popup Shield default watch mode, protection strategy, and per-host sandbox compatibility rules" },
        "branding": { "type": "object", "description": "Website Branding settings (logo, site name typography, and browser favicon configuration)" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteName", "tagline", "announcementText", "tickerEnabled", "featuredLimit", "maintenanceMode", "maintenanceMessage", "updatedBy", "updatedAt"]
    },
    "MediaRating": {
      "title": "MediaRating",
      "description": "Authenticated user 1-to-5 star rating for a media catalog item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mediaId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "stars": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "mediaId", "userId", "stars", "createdAt", "updatedAt"]
    },
    "AdminActivityLog": {
      "title": "AdminActivityLog",
      "description": "Audit log entry recording operations executed or queried by the Local Admin Assistant.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adminName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "rawCommand": { "type": "string", "minLength": 1, "maxLength": 500 },
        "understoodCommand": { "type": "string", "minLength": 1, "maxLength": 500 },
        "operationType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "operationLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "affectedCount": { "type": "number" },
        "sampleTitles": { "type": "array", "description": "Up to 10 sample titles affected by the operation" },
        "status": { "type": "string", "enum": ["executed", "queried", "undone", "blocked", "failed"] },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "adminUid",
        "adminName",
        "rawCommand",
        "understoodCommand",
        "operationType",
        "operationLabel",
        "affectedCount",
        "sampleTitles",
        "status",
        "note",
        "createdAt"
      ]
    },
    "CustomFont": {
      "title": "CustomFont",
      "description": "Admin-uploaded or linked custom Arabic/English font asset stored per language slot.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["arabic", "english"] },
        "family": { "type": "string", "minLength": 1, "maxLength": 80 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "format": { "type": "string", "enum": ["woff2", "woff", "truetype", "opentype", "css"] },
        "sourceUrl": { "type": "string", "minLength": 10, "maxLength": 950000 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "family", "fileName", "format", "sourceUrl", "updatedBy", "updatedAt"]
    },
    "ScraperAdapter": {
      "title": "ScraperAdapter",
      "description": "Per-site declarative scraping adapter configuration, status, and latest test summary.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "domain": { "type": "string", "minLength": 3, "maxLength": 160 },
        "domainAliases": { "type": "array", "description": "Optional mirror hostnames (up to 20)" },
        "enabled": { "type": "boolean" },
        "status": { "type": "string", "enum": ["supported", "needs_fix", "failed"] },
        "contentTypeHint": { "type": "string", "enum": ["series", "movie", "episode", "auto"] },
        "sampleUrl": { "type": "string", "maxLength": 500 },
        "version": { "type": "number" },
        "pageDetection": { "type": "object" },
        "episodeRules": { "type": "object" },
        "serverRules": { "type": "object" },
        "navigationRules": { "type": "object" },
        "siteSettings": { "type": "object" },
        "lastTestSummary": { "type": "object" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "name", "domain", "domainAliases", "enabled", "status",
        "contentTypeHint", "sampleUrl", "version", "pageDetection",
        "episodeRules", "serverRules", "navigationRules", "siteSettings",
        "updatedBy", "createdAt", "updatedAt"
      ]
    },
    "ScraperAdapterVersion": {
      "title": "ScraperAdapterVersion",
      "description": "Immutable historical version snapshot for a ScraperAdapter supporting rollback.",
      "type": "object",
      "properties": {
        "versionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adapterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "version": { "type": "number" },
        "changeNote": { "type": "string", "maxLength": 400 },
        "snapshot": { "type": "object" },
        "savedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["versionId", "adapterId", "version", "changeNote", "snapshot", "savedBy", "createdAt"]
    },
    "AdminWorkspaceConfig": {
      "title": "AdminWorkspaceConfig",
      "description": "Admin workspace configuration for appearance, sidebar navigation layout, moderator permissions, and cross-device sanitized database connection profiles.",
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["appearance", "nav_layout", "moderator_perms", "db_connections"] },
        "config": { "type": "object", "description": "Normalized workspace JSON object (never contains private server secrets)" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["kind", "config", "updatedBy", "updatedAt"]
    },
    "HomeLayoutSettings": {
      "title": "HomeLayoutSettings",
      "description": "Dedicated settings document storing core homepage layout and hero autoplay fields.",
      "type": "object",
      "properties": {
        "showHero": { "type": "boolean" },
        "heroMode": { "type": "string", "enum": ["auto", "manual", "brand"] },
        "heroMediaId": { "type": "string", "maxLength": 128 },
        "heroBadgeText": { "type": "string", "maxLength": 50 },
        "heroHeadline": { "type": "string", "maxLength": 160 },
        "heroDescription": { "type": "string", "maxLength": 320 },
        "heroPrimaryCta": { "type": "string", "minLength": 1, "maxLength": 40 },
        "heroShowHighlights": { "type": "boolean" },
        "heroAutoPlay": { "type": "boolean" },
        "heroSlideIntervalSec": { "type": "number" },
        "heroShowProgressBar": { "type": "boolean" },
        "heroShowThumbnails": { "type": "boolean" },
        "heroShowArrows": { "type": "boolean" },
        "heroPauseOnHover": { "type": "boolean" },
        "heroMaxSlides": { "type": "number" },
        "heroSlideIds": { "type": "array" },
        "showQuickFilters": { "type": "boolean" },
        "showCategoryBar": { "type": "boolean" },
        "showFullLibrary": { "type": "boolean" },
        "showRequestBanner": { "type": "boolean" },
        "cardsPerRow": { "type": "number" },
        "cardStyle": {
          "type": "string",
          "enum": [
            "clean", "classic", "showcase",
            "3d-obsidian-tilt", "3d-cinema-stage", "3d-neon-prism", "3d-glass-float",
            "3d-gold-bevel", "3d-stacked-deck", "3d-hologram-edge", "3d-theater-curtain",
            "3d-poster-lift", "3d-dual-flip", "3d-corner-fold", "3d-cyber-frame",
            "3d-velvet-depth", "3d-chrome-plate", "3d-spotlight-arc", "3d-polaroid-slab",
            "3d-split-slice", "3d-metallic-crest"
          ]
        },
        "sections": { "type": "array" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "showHero", "heroMode", "heroMediaId", "heroBadgeText", "heroHeadline",
        "heroDescription", "heroPrimaryCta", "heroShowHighlights",
        "showQuickFilters", "showCategoryBar", "showFullLibrary",
        "showRequestBanner", "cardsPerRow", "cardStyle", "sections",
        "updatedBy", "updatedAt"
      ]
    },
    "SliderStyleSettings": {
      "title": "SliderStyleSettings",
      "description": "Dedicated settings document storing hero slider typography, alignment, image fit, and element visibility options.",
      "type": "object",
      "properties": {
        "heroShowDescription": { "type": "boolean" },
        "heroTitleSizePx": { "type": "number" },
        "heroDescriptionSizePx": { "type": "number" },
        "heroDescriptionLines": { "type": "number" },
        "heroTextAlign": { "type": "string", "enum": ["right", "center", "left"] },
        "heroInfoPosition": { "type": "string", "enum": ["bottom-right", "bottom-center", "bottom-left", "middle-right", "middle-center", "middle-left"] },
        "heroTextMaxWidthPx": { "type": "number" },
        "heroImageFit": { "type": "string", "enum": ["contain", "cover", "contain_blur"] },
        "heroBackdropBlurPx": { "type": "number" },
        "heroBackdropDimPct": { "type": "number" },
        "heroShowBadge": { "type": "boolean" },
        "heroShowRating": { "type": "boolean" },
        "heroShowYear": { "type": "boolean" },
        "heroShowDuration": { "type": "boolean" },
        "heroShowGenres": { "type": "boolean" },
        "heroShowQuality": { "type": "boolean" },
        "heroShowWatchBtn": { "type": "boolean" },
        "heroShowDetailsBtn": { "type": "boolean" },
        "heroShowWatchlistBtn": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "heroShowDescription", "heroTitleSizePx", "heroDescriptionSizePx",
        "heroDescriptionLines", "heroTextAlign", "heroInfoPosition",
        "heroTextMaxWidthPx", "heroImageFit", "heroBackdropBlurPx", "heroBackdropDimPct",
        "heroShowBadge", "heroShowRating", "heroShowYear", "heroShowDuration",
        "heroShowGenres", "heroShowQuality", "heroShowWatchBtn", "heroShowDetailsBtn",
        "heroShowWatchlistBtn", "updatedBy", "updatedAt"
      ]
    },
    "SiteBrandingSettings": {
      "title": "SiteBrandingSettings",
      "description": "Dedicated settings document storing website branding, logo, title typography, and favicon fields.",
      "type": "object",
      "properties": {
        "logoMode": { "type": "string", "enum": ["image_and_text", "image_only", "text_only", "hidden"] },
        "logoUrl": { "type": "string", "maxLength": 600 },
        "logoWidthPx": { "type": "number" },
        "logoHeightPx": { "type": "number" },
        "logoPlacement": { "type": "string", "enum": ["before_text", "after_text", "above_text"] },
        "headerAlign": { "type": "string", "enum": ["start", "center"] },
        "logoTextGapPx": { "type": "number" },
        "siteName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "siteNameColor": { "type": "string" },
        "siteNameFont": { "type": "string", "minLength": 1, "maxLength": 60 },
        "siteNameSizePx": { "type": "number" },
        "siteNameWeight": { "type": "number" },
        "siteNameLetterSpacingPx": { "type": "number" },
        "faviconMode": { "type": "string", "enum": ["default", "custom", "none"] },
        "faviconUrl": { "type": "string", "maxLength": 600 },
        "faviconMimeType": { "type": "string", "maxLength": 80 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "logoMode", "logoUrl", "logoWidthPx", "logoHeightPx", "logoPlacement",
        "headerAlign", "logoTextGapPx", "siteName", "siteNameColor", "siteNameFont",
        "siteNameSizePx", "siteNameWeight", "siteNameLetterSpacingPx",
        "faviconMode", "faviconUrl", "updatedBy", "updatedAt"
      ]
    },
    "ImagePlaceholderSettings": {
      "title": "ImagePlaceholderSettings",
      "description": "Site-wide image loading placeholder and broken fallback customization managed by owner admins.",
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["solid", "gradient", "shimmer", "logo_badge", "custom_image"] },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "gradientAngle": { "type": "number" },
        "shimmerEnabled": { "type": "boolean" },
        "shimmerSpeed": { "type": "string", "enum": ["slow", "normal", "fast"] },
        "showLogoOverlay": { "type": "boolean" },
        "logoOverlayOpacityPct": { "type": "number" },
        "customImageUrl": { "type": "string", "maxLength": 600 },
        "errorFallbackImageUrl": { "type": "string", "maxLength": 600 },
        "backdropDimPct": { "type": "number" },
        "showFallbackIcon": { "type": "boolean" },
        "fadeInDurationMs": { "type": "number" },
        "slotOverrides": { "type": "object" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "mode", "primaryColor", "secondaryColor", "gradientAngle",
        "shimmerEnabled", "shimmerSpeed", "showLogoOverlay", "logoOverlayOpacityPct",
        "customImageUrl", "errorFallbackImageUrl", "backdropDimPct",
        "showFallbackIcon", "fadeInDurationMs", "slotOverrides",
        "updatedBy", "updatedAt"
      ]
    },
    "RecentlyWatchedUiSettings": {
      "title": "RecentlyWatchedUiSettings",
      "description": "Global admin-controlled display, card sizing, batch loading, sorting, and per-device layout settings for the Recently Watched horizontal carousel.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "showTitle": { "type": "boolean" },
        "showViewAllButton": { "type": "boolean" },
        "showArrows": { "type": "boolean" },
        "enableDrag": { "type": "boolean" },
        "autoScroll": { "type": "boolean" },
        "autoScrollIntervalSec": { "type": "number" },
        "scrollDirection": { "type": "string", "enum": ["rtl", "ltr"] },
        "enableWheelScroll": { "type": "boolean" },
        "cardStyle": {
          "type": "string",
          "enum": [
            "rw-3d-tilt", "rw-3d-glass", "rw-3d-stacked", "rw-3d-neon-bevel",
            "rw-3d-floating-stage", "rw-3d-prism", "rw-3d-velvet-arch"
          ]
        },
        "cardSizePreset": { "type": "string", "enum": ["small", "medium", "large", "custom"] },
        "cardWidthPx": { "type": "number" },
        "cardGapPx": { "type": "number" },
        "aspectRatio": { "type": "string", "enum": ["2/3", "3/4", "16/9", "4/3", "1/1"] },
        "showMediaTitle": { "type": "boolean" },
        "showWatchedAt": { "type": "boolean" },
        "showProgressBar": { "type": "boolean" },
        "showEpisodeInfo": { "type": "boolean" },
        "maxStoredItems": { "type": "number" },
        "initialVisibleCount": { "type": "number" },
        "loadMoreOnScrollEnd": { "type": "boolean" },
        "loadMoreBatchSize": { "type": "number" },
        "sortOrder": { "type": "string", "enum": ["newest_first", "oldest_first", "custom"] },
        "customOrderIds": { "type": "array", "items": { "type": "string" } },
        "hideCompleted": { "type": "boolean" },
        "deduplicateItems": { "type": "boolean" },
        "deviceMode": { "type": "string", "enum": ["unified", "per_device"] },
        "deviceSettings": { "type": "object" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "enabled", "showTitle", "showViewAllButton", "showArrows",
        "enableDrag", "autoScroll", "autoScrollIntervalSec", "scrollDirection",
        "enableWheelScroll", "cardSizePreset", "cardWidthPx", "cardGapPx",
        "aspectRatio", "showMediaTitle", "showWatchedAt", "showProgressBar",
        "showEpisodeInfo", "maxStoredItems", "initialVisibleCount",
        "loadMoreOnScrollEnd", "loadMoreBatchSize", "sortOrder",
        "customOrderIds", "hideCompleted", "deduplicateItems",
        "deviceMode", "deviceSettings", "updatedBy", "updatedAt"
      ]
    },
    "RecentlyWatchedEntry": {
      "title": "RecentlyWatchedEntry",
      "description": "User-scoped playback history entry deduplicated per media item for Recently Watched section.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mediaId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "type": "string", "enum": ["movie", "series", "tv", "wrestling"] },
        "poster": { "type": "string", "maxLength": 500 },
        "backdrop": { "type": "string", "maxLength": 500 },
        "year": { "type": "string", "maxLength": 10 },
        "quality": { "type": "string", "maxLength": 40 },
        "slug": { "type": "string", "maxLength": 128 },
        "englishTitle": { "type": "string", "maxLength": 200 },
        "positionSec": { "type": "number" },
        "durationSec": { "type": "number" },
        "progressPct": { "type": "number" },
        "completed": { "type": "boolean" },
        "seasonNumber": { "type": "number" },
        "episodeNumber": { "type": "number" },
        "episodeTitle": { "type": "string", "maxLength": 120 },
        "lastServerIndex": { "type": "number" },
        "lastServerUrl": { "type": "string", "maxLength": 600 },
        "lastWatchedAtMs": { "type": "number" },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "mediaId", "title", "kind", "poster", "backdrop",
        "year", "quality", "slug", "englishTitle", "positionSec", "durationSec",
        "progressPct", "completed", "lastWatchedAtMs", "createdAtMs", "updatedAt"
      ]
    },
    "SiteThemeSettings": {
      "title": "SiteThemeSettings",
      "description": "Active visual site theme (default + 25 distinct site themes) stored in /settings/site_theme.",
      "type": "object",
      "properties": {
        "siteThemeId": {
          "type": "string",
          "enum": [
            "default",
            "cyber-crimson", "royal-gold", "midnight-sapphire", "emerald-noir",
            "sunset-amber", "velvet-plum", "ocean-teal", "volcanic-copper",
            "arctic-frost", "ivory-editorial", "espresso-noir", "nordic-slate",
            "cherry-obsidian", "neon-mint", "titanium-steel", "champagne-luxe",
            "electric-indigo", "forest-sage", "desert-dune", "monochrome-silver",
            "crimson-velvet", "aurora-violet", "cobalt-storm", "rose-quartz-dark",
            "golden-pharaoh"
          ]
        },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteThemeId", "updatedBy", "updatedAt"]
    },
    "ActiveDatabasePointer": {
      "title": "ActiveDatabasePointer",
      "description": "Public pointer to the currently active Firebase project/database configuration stored in /settings/active_database without any server secrets.",
      "type": "object",
      "properties": {
        "connectionId": { "type": "string", "minLength": 1, "maxLength": 96 },
        "connectionName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "providerType": { "type": "string", "enum": ["firebase_firestore"] },
        "firebaseConfig": { "type": "object" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["connectionId", "connectionName", "providerType", "firebaseConfig", "updatedBy", "updatedAt"]
    },
    "HeroSliderModeSettings": {
      "title": "HeroSliderModeSettings",
      "description": "Selected homepage hero slider design variants for desktop and mobile stored in /settings/hero_slider_mode.",
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "original",
            "cinematic",
            "stream_v4",
            "mobile_stories",
            "mobile_cards",
            "mobile_spotlight"
          ]
        },
        "mobileVariant": {
          "type": "string",
          "enum": [
            "original",
            "cinematic",
            "stream_v4",
            "mobile_stories",
            "mobile_cards",
            "mobile_spotlight"
          ]
        },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["variant", "updatedBy", "updatedAt"]
    },
    "StreamV4SliderSettings": {
      "title": "StreamV4SliderSettings",
      "description": "Configuration, PNG logos, and per-movie slide durations for the 4th Cinema V4 Hero Slider stored in /settings/stream_v4_slider.",
      "type": "object",
      "properties": {
        "titleLogos": { "type": "object" },
        "defaultSlideDurationSec": { "type": "number" },
        "slideDurations": { "type": "object" },
        "usePngLogoInHero": { "type": "boolean" },
        "usePngLogoInStrip": { "type": "boolean" },
        "showTitle": { "type": "boolean" },
        "showMetadata": { "type": "boolean" },
        "showStory": { "type": "boolean" },
        "storyLines": { "type": "number" },
        "showCast": { "type": "boolean" },
        "showWatchBtn": { "type": "boolean" },
        "watchBtnText": { "type": "string", "minLength": 1, "maxLength": 60 },
        "showWatchlistBtn": { "type": "boolean" },
        "showTagline": { "type": "boolean" },
        "showBottomStrip": { "type": "boolean" },
        "showProgressBar": { "type": "boolean" },
        "progressBarHeightPx": { "type": "number" },
        "showNavArrows": { "type": "boolean" },
        "enableShineEffect": { "type": "boolean" },
        "colorMode": { "type": "string", "enum": ["site_theme", "custom"] },
        "customAccentColor": { "type": "string" },
        "scrimIntensityPct": { "type": "number" },
        "bottomBlendHeightPx": { "type": "number" },
        "bottomBlurPx": { "type": "number" },
        "bottomOverlapPx": { "type": "number" },
        "articleVerticalAlign": { "type": "string", "enum": ["top", "center", "bottom"] },
        "articleHorizontalAlign": { "type": "string", "enum": ["right", "center", "left"] },
        "articleBottomOffsetPx": { "type": "number" },
        "articleTopOffsetPx": { "type": "number" },
        "articleSideOffsetPx": { "type": "number" },
        "articleMaxWidthPx": { "type": "number" },
        "dotsBottomOffsetPx": { "type": "number" },
        "sliderHeightDesktopPx": { "type": "number" },
        "logoMaxHeightPx": { "type": "number" },
        "logoMaxWidthPx": { "type": "number" },
        "titleSizePx": { "type": "number" },
        "metaSizePx": { "type": "number" },
        "storySizePx": { "type": "number" },
        "castSizePx": { "type": "number" },
        "stripLogoHeightPx": { "type": "number" },
        "stripTextSizePx": { "type": "number" },
        "maxStripItems": { "type": "number" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleLogos", "defaultSlideDurationSec", "slideDurations",
        "usePngLogoInHero", "usePngLogoInStrip", "showTitle", "showMetadata",
        "showStory", "storyLines", "showCast", "showWatchBtn", "watchBtnText",
        "showWatchlistBtn", "showTagline", "showBottomStrip", "showProgressBar",
        "progressBarHeightPx", "showNavArrows", "enableShineEffect",
        "colorMode", "customAccentColor", "scrimIntensityPct",
        "bottomBlendHeightPx", "bottomBlurPx", "bottomOverlapPx",
        "articleVerticalAlign", "articleHorizontalAlign",
        "articleBottomOffsetPx", "articleTopOffsetPx", "articleSideOffsetPx",
        "articleMaxWidthPx", "dotsBottomOffsetPx", "sliderHeightDesktopPx",
        "logoMaxHeightPx", "logoMaxWidthPx", "titleSizePx", "metaSizePx",
        "storySizePx", "castSizePx", "stripLogoHeightPx", "stripTextSizePx",
        "maxStripItems", "updatedBy", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/Media" },
      "description": "Catalog collection of movies, series, TV programs, and wrestling events."
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/VisitorRequest" },
      "description": "Visitor and user requests for upcoming movies or series."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and saved watchlist IDs (isolated from PII)."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated private PII document storing user email."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted administrator registry for dashboard RBAC."
    },
    "/settings/home_layout": {
      "schema": { "$ref": "#/entities/HomeLayoutSettings" },
      "description": "Dedicated split document storing core homepage layout and hero autoplay settings."
    },
    "/settings/slider_style": {
      "schema": { "$ref": "#/entities/SliderStyleSettings" },
      "description": "Dedicated split document storing hero slider visual styling and element visibility."
    },
    "/settings/site_branding": {
      "schema": { "$ref": "#/entities/SiteBrandingSettings" },
      "description": "Dedicated split document storing website branding and favicon settings."
    },
    "/settings/image_placeholders": {
      "schema": { "$ref": "#/entities/ImagePlaceholderSettings" },
      "description": "Dedicated settings document storing global and per-slot image loading placeholders and fallback visuals."
    },
    "/settings/recently_watched_ui": {
      "schema": { "$ref": "#/entities/RecentlyWatchedUiSettings" },
      "description": "Dedicated settings document storing horizontal carousel configuration, 3D card style, and per-device sizing for Recently Watched."
    },
    "/settings/site_theme": {
      "schema": { "$ref": "#/entities/SiteThemeSettings" },
      "description": "Dedicated settings document storing the active site visual theme across default and 25 alternative themes."
    },
    "/settings/active_database": {
      "schema": { "$ref": "#/entities/ActiveDatabasePointer" },
      "description": "Active Firebase connection pointer synced across visitor and admin devices."
    },
    "/settings/hero_slider_mode": {
      "schema": { "$ref": "#/entities/HeroSliderModeSettings" },
      "description": "Active homepage hero slider design variant (original, cinematic, stream_v4)."
    },
    "/settings/stream_v4_slider": {
      "schema": { "$ref": "#/entities/StreamV4SliderSettings" },
      "description": "Cinema V4 4th slider visual settings, PNG logos, and per-movie slide durations."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global platform configuration controlled by admins."
    },
    "/recently_watched/{entryId}": {
      "schema": { "$ref": "#/entities/RecentlyWatchedEntry" },
      "description": "Private user-scoped playback history entries synced for signed-in accounts."
    },
    "/ratings/{ratingId}": {
      "schema": { "$ref": "#/entities/MediaRating" },
      "description": "User star ratings (1 to 5 stars) keyed deterministically by mediaId and userId."
    },
    "/admin_activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminActivityLog" },
      "description": "Immutable admin audit log of Local Admin Assistant commands and executions."
    },
    "/fonts/{fontId}": {
      "schema": { "$ref": "#/entities/CustomFont" },
      "description": "Publicly readable custom Arabic and English webfont assets uploaded by owner admins."
    },
    "/scraper_adapters/{adapterId}": {
      "schema": { "$ref": "#/entities/ScraperAdapter" },
      "description": "Site-specific scraping adapters built and tested via Smart Scraper Adapter Builder."
    },
    "/scraper_adapters/{adapterId}/versions/{versionId}": {
      "schema": { "$ref": "#/entities/ScraperAdapterVersion" },
      "description": "Immutable version history snapshots for rollback of ScraperAdapters."
    },
    "/admin_workspace/{docId}": {
      "schema": { "$ref": "#/entities/AdminWorkspaceConfig" },
      "description": "Owner-only admin dashboard appearance and navigation layout configuration."
    }
  }
}

